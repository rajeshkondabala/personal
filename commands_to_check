echo "===== HOST ====="
hostname; date; uname -a
cat /etc/os-release 2>/dev/null | sed -n '1,8p'

echo "===== CPU / GLIBC ====="
lscpu 2>/dev/null | grep -E 'Model name|Architecture|CPU\(s\)|Thread|Socket' || true
ldd --version | head -1

echo "===== MODULES (if Lmod/Environment Modules) ====="
(type module >/dev/null 2>&1 && module list 2>&1) || echo "no module command"
echo "MODULEPATH=${MODULEPATH-}"

echo "===== CUDA / GPU ====="
echo "CUDA_HOME=${CUDA_HOME-unset}"
echo "CUDA_PATH=${CUDA_PATH-unset}"
echo "which nvcc: $(command -v nvcc || echo none)"
nvcc --version 2>/dev/null || true
ls -d /usr/local/cuda* /opt/cuda* /home/*/cuda* /apps/cuda* 2>/dev/null | head
nvidia-smi -L 2>/dev/null || echo "no nvidia-smi"
nvidia-smi --query-gpu=name,compute_cap,driver_version --format=csv 2>/dev/null || true
echo "PATH nvcc dir:"; echo "$PATH" | tr ':' '\n' | grep -i cuda | head

echo "===== COMPILERS ====="
echo "which gcc: $(command -v gcc || echo none)"; gcc --version 2>/dev/null | head -1
echo "which g++: $(command -v g++ || echo none)"; g++ --version 2>/dev/null | head -1
echo "which g++-12: $(command -v g++-12 || echo none)"
echo "which cmake: $(command -v cmake || echo none)"; cmake --version 2>/dev/null | head -1
echo "CC=${CC-unset} CXX=${CXX-unset} CUDAHOSTCXX=${CUDAHOSTCXX-unset}"

echo "===== CONDA ====="
echo "which conda: $(command -v conda || echo none)"
conda --version 2>/dev/null || true
conda info --base 2>/dev/null || true
conda env list 2>/dev/null || true
echo "CONDA_PREFIX=${CONDA_PREFIX-unset}"
echo "CONDA_DEFAULT_ENV=${CONDA_DEFAULT_ENV-unset}"

echo "===== NETWORK (conda-forge) ====="
python3 -c "import urllib.request; urllib.request.urlopen('https://conda.anaconda.org/conda-forge', timeout=10); print('conda-forge reachable')" 2>&1 | tail -3

echo "===== SYSTEM RDKIT / BOOST / OPENBABEL (must not mix into conda build) ====="
ls /usr/include/rdkit/GraphMol/RDKitBase.h 2>/dev/null || echo "no system RDKit headers"
ls /usr/lib/libRDKitGraphMol.so /usr/lib/x86_64-linux-gnu/libRDKitGraphMol.so 2>/dev/null || echo "no system RDKit libs"
ls /usr/include/boost/version.hpp 2>/dev/null && grep BOOST_LIB_VERSION /usr/include/boost/version.hpp || echo "no /usr boost"
command -v obabel; command -v obabel3
echo "LD_LIBRARY_PATH=${LD_LIBRARY_PATH-}"
echo "CPATH=${CPATH-}"
echo "LIBRARY_PATH=${LIBRARY_PATH-}"
echo "CPLUS_INCLUDE_PATH=${CPLUS_INCLUDE_PATH-}"

echo "===== GNINA SOURCE ====="
ls -d $HOME/gnina-1.3.3-rdkit-QC /home/*/gnina-1.3.3-rdkit-QC 2>/dev/null
test -f $HOME/gnina-1.3.3-rdkit-QC/gninasrc/lib/szv_grid.h && \
  grep -n 'unordered_map' $HOME/gnina-1.3.3-rdkit-QC/gninasrc/lib/szv_grid.h | head

echo "===== DISK ====="
df -h "$HOME" . 2>/dev/null | head
