#include "szv_grid.h"
#include "brick.h"

#include <unordered_map>
#include <boost/functional/hash.hpp>

namespace boost {
inline bool operator==(const array<int, 3> &a, const array<int, 3> &b) {
  return a[0] == b[0] && a[1] == b[1] && a[2] == b[2];
}

inline std::size_t hash_value(const array<int, 3> &e) {
  std::size_t seed = 0;
  boost::hash_combine(seed, e[0]);
  boost::hash_combine(seed, e[1]);
  boost::hash_combine(seed, e[2]);
  return seed;
}
}

struct ijk_hash {
  std::size_t operator()(const boost::array<int, 3> &e) const {
    return boost::hash<boost::array<int, 3>>()(e);
  }
};

struct szv_grid_cache::cache_impl {
  std::unordered_map<szv_grid_cache::ijk, szv*, ijk_hash> cache;
};

szv_grid_cache::szv_grid_cache(const model& m_, fl cut)
    : impl(new cache_impl()), m(m_), cutoff_sqr(cut) {
}

szv_grid_cache::~szv_grid_cache() {
  for (auto itr = impl->cache.begin(), end = impl->cache.end(); itr != end;
      ++itr) {
    delete itr->second;
  }
  delete impl;
}

const szv* szv_grid_cache::get(const vec& coord,
    const szv& relevant_indices) const {
  ijk index;
  for (sz i = 0; i < 3; i++) {
    index[i] = std::floor(coord[i] / granularity);
  }

  auto& cache = impl->cache;
  if (cache.count(index) == 0) {
    szv *atoms = new szv();
    vec lower, upper;
    for (sz i = 0; i < 3; i++) {
      lower[i] = std::floor(coord[i] / granularity) * granularity;
      upper[i] = std::ceil(coord[i] / granularity) * granularity;
    }
    VINA_FOR_IN(ri, relevant_indices) {
      const sz i = relevant_indices[ri];
      const atom& a = m.grid_atoms[i];
      if (!a.is_hydrogen() && a.acceptable_type()) {
        if (brick_distance_sqr(lower, upper, a.coords) < cutoff_sqr)
          atoms->push_back(i);
      }
    }
    cache[index] = atoms;
  }
  return cache[index];
}
