conda activate gnina-build

conda install -y -c conda-forge \
  "python=3.11" \
  "gcc=12" "gxx=12" \
  "libboost=1.84.*" \
  "libboost-devel=1.84.*" \
  "libboost-headers=1.84.*" \
  "libboost-python=1.84.*" \
  "libboost-python-devel=1.84.*" \
  "rdkit=2024.03.6" \
  "librdkit=2024.03.6" \
  "librdkit-dev=2024.03.6" \
  jsoncpp zlib protobuf libprotobuf \
  patchelf cmake cudnn

python -m pip install --upgrade pip
python -m pip install torch --index-url https://download.pytorch.org/whl/cu121

conda activate gnina-build
hash -r

echo "gcc:  $(command -v gcc)"; gcc --version | head -1
echo "g++:  $(command -v g++)"; g++ --version | head -1
echo "cmake: $(command -v cmake)"; cmake --version | head -1
# gcc/g++/cmake must be .../envs/gnina-build/bin/...  NOT /usr/bin/gcc

grep BOOST_LIB_VERSION "$CONDA_PREFIX/include/boost/version.hpp"
# 1_84

test -f "$CONDA_PREFIX/include/rdkit/GraphMol/RDKitBase.h" && echo RDKit_headers_OK
python -c "import torch,rdkit; print('torch', torch.__version__, 'abi', torch._C._GLIBCXX_USE_CXX11_ABI, 'cuda', torch.version.cuda)"
# torch ...+cu121  abi False  cuda 12.1

conda activate gnina-build
export CUDA_HOME=/usr/local/cuda-12.2
export PATH="$CONDA_PREFIX/bin:$CUDA_HOME/bin:$PATH"
export CC="$CONDA_PREFIX/bin/gcc"
export CXX="$CONDA_PREFIX/bin/g++"
export CUDAHOSTCXX="$CXX"

export SRC=$HOME/gnina-1.3.3-rdkit-QC
export BUILD=$HOME/gnina-1.3.3-build-gnina
export TORCH_PREFIX="$(python -c 'import torch,os; print(os.path.dirname(torch.__file__))')"

rm -rf "$BUILD"
mkdir -p "$BUILD"

cmake -S "$SRC" -B "$BUILD" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_C_COMPILER="$CC" \
  -DCMAKE_CXX_COMPILER="$CXX" \
  -DCMAKE_CUDA_HOST_COMPILER="$CXX" \
  -DCMAKE_CXX_FLAGS="-D_GLIBCXX_USE_CXX11_ABI=0" \
  -DCMAKE_CUDA_FLAGS="-Xcompiler -D_GLIBCXX_USE_CXX11_ABI=0" \
  -DBOOST_ROOT="$CONDA_PREFIX" \
  -DBoost_NO_SYSTEM_PATHS=ON \
  -DCMAKE_CUDA_ARCHITECTURES=80 \
  -DGNINA_DISALLOW_OPENBABEL=ON \
  -DCMAKE_DISABLE_FIND_PACKAGE_OpenBabel3=TRUE \
  -DBUILD_PYGNINA=OFF \
  -DCMAKE_PREFIX_PATH="${CONDA_PREFIX};${TORCH_PREFIX};${CUDA_HOME}" \
  -DCUDA_TOOLKIT_ROOT_DIR="${CUDA_HOME}" \
  -DTorch_DIR="${TORCH_PREFIX}/share/cmake/Torch" \
  -DPython3_EXECUTABLE="${CONDA_PREFIX}/bin/python3" \
  -DZLIB_ROOT="$CONDA_PREFIX" \
  -DZLIB_INCLUDE_DIR="$CONDA_PREFIX/include" \
  -DZLIB_LIBRARY="$CONDA_PREFIX/lib/libz.so" \
  -DRDKIT_INCLUDE_DIR="$CONDA_PREFIX/include/rdkit" \
  -DRDKIT_LIBRARY_DIR="$CONDA_PREFIX/lib" \
  -DCUDNN_INCLUDE_PATH="$CONDA_PREFIX/include" \
  -DCUDNN_LIBRARY_PATH="$CONDA_PREFIX/lib/libcudnn.so"

cmake --build "$BUILD" --parallel "$(nproc)" --target gnina








