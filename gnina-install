conda create -y -n gnina-build

conda activate gnina-build

conda install -y -c conda-forge \
  "python=3.11" \
  "gcc=12" "gxx=12" \
  "libboost=1.84.*" \
  "libboost-devel=1.84.*" \
  "libboost-headers=1.84.*" \
  "libboost-python=1.84.*" \
  "libboost-python-devel=1.84.*" \
  "rdkit=2024.03.6" \
  "librdkit=2024.03.6" \
  "librdkit-dev=2024.03.6" \
  jsoncpp zlib protobuf libprotobuf \
  patchelf cmake cudnn

python -m pip install torch==2.5.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121


which gcc g++
gcc --version
export CUDA_HOME=/usr/local/cuda-12.2
export PATH="$CUDA_HOME/bin:$PATH"
export CC=$(which gcc)
export CXX=$(which g++)
export CUDAHOSTCXX=$CXX
export TORCH_PREFIX=$(python -c 'import torch,os; print(os.path.dirname(torch.__file__))')
export Boost_DIR=$(find "$CONDA_PREFIX/lib/cmake" \
  -maxdepth 1 \
  -type d \
  -name 'Boost-*' | head -1)
export SRC=/home/rajeshk/gnina-1.3.3-rdkit-QC
export BUILD=/home/rajeshk/gnina-1.3.3_build

rm -rf "$BUILD"
mkdir -p "$BUILD"

cmake -S "$SRC" -B "$BUILD" -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER="$CC" -DCMAKE_CXX_COMPILER="$CXX" -DCMAKE_CUDA_COMPILER=/usr/local/cuda-12.2/bin/nvcc -DCMAKE_CUDA_HOST_COMPILER="$CXX" -DBOOST_ROOT="$CONDA_PREFIX" -DCMAKE_CUDA_ARCHITECTURES=80 -DGNINA_DISALLOW_OPENBABEL=ON -DCMAKE_DISABLE_FIND_PACKAGE_OpenBabel3=TRUE -DBUILD_PYGNINA=OFF -DCMAKE_PREFIX_PATH="${CONDA_PREFIX};${TORCH_PREFIX};${CUDA_HOME}" -DCUDA_TOOLKIT_ROOT_DIR="${CUDA_HOME}" -DTorch_DIR="${TORCH_PREFIX}/share/cmake/Torch" -DPython3_EXECUTABLE="${CONDA_PREFIX}/bin/python3" -DZLIB_ROOT="$CONDA_PREFIX" -DZLIB_INCLUDE_DIR="$CONDA_PREFIX/include" -DZLIB_LIBRARY="$CONDA_PREFIX/lib/libz.so" -DRDKIT_INCLUDE_DIR="$CONDA_PREFIX/include/rdkit" -DRDKIT_LIBRARY_DIR="$CONDA_PREFIX/lib" -DCUDNN_INCLUDE_PATH="$CONDA_PREFIX/include" -DCUDNN_LIBRARY_PATH="$CONDA_PREFIX/lib/libcudnn.so"

cmake --build "$BUILD" --parallel "$(nproc)" --target gnina
